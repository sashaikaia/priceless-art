<!DOCTYPE html>
<html>
    <%- include('partials/header') %>
    <%- include('partials/nav') %>

    <body>
        <div class="text">
            <p>This gallery is our permanent collection of priceless art.</p>
            <p>Return <a href="/">home</a> to generate a new painting. </p>
        </div>
        <div id="gallery">
            <% gallery.forEach((obj) => { %>
            <div class="art" data-art="<%= JSON.stringify(obj) %>"></div>
            <% }) %>
        </div>
        <script>
            document.querySelectorAll('.art').forEach((el) => {
                new p5((p) => sketch(p, JSON.parse(el.dataset.art), el));
            });
        </script>
    </body>

    <%- include('partials/footer') %>
</html>
