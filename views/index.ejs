<!DOCTYPE html>
<html>
    <%- include('partials/header') %>
    <%- include('partials/nav') %>
    <body>
        <div class="text">
            <p>This is a one-of-a-kind digital painting generated just for you:</p>
        </div>
        <div id="painting" class="art" data-art="<%= artObject %>"></div>
        <script>
            const el = document.getElementById('painting');
            new p5((p) => sketch(p, JSON.parse(el.dataset.art), el));
        </script>
    <form form id="index" action="/" method="POST">
        <input class="button" type="submit" name="refresh" value="Refresh" formaction="refresh">
        <input class="button" type="submit" name="submit" value="Submit" formaction="submit">
        <input id="myArtObject" type="hidden" name="myArtObject" value="<%= artObject %>">
    </form>
    <div class ="text">
        <p>Add it to the permanent collection with the <strong>Submit</strong> button or generate a new painting with the <strong>Refresh</strong> button (or by refreshing the page).</p>
    </div>
    </body>

    <%- include('partials/footer') %>
</html>